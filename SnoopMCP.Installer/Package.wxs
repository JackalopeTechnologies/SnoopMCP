<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

    <Package Name="SnoopMCP"
             Manufacturer="Jackalope Technologies, Inc."
             Version="$(var.Version)"
             UpgradeCode="7E3B1C2A-9D4F-4A6E-B8C1-2F5A9E0D3B47"
             Scope="perUser">

        <MajorUpgrade DowngradeErrorMessage="A newer version of SnoopMCP is already installed."
                      AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" />
        <MediaTemplate EmbedCab="yes" />

        <!-- Terminate the running host before any file work so upgrade/uninstall don't hit a
             locked SnoopMCP.Host.exe (the logon task keeps it running between installs). The host
             is windowless, so a hard terminate is required. -->
        <util:CloseApplication Id="CloseRecovery" Target="SnoopMCP.Recovery.exe"
                               TerminateProcess="0" RebootPrompt="no" Sequence="1" />
        <util:CloseApplication Id="CloseHost" Target="SnoopMCP.Host.exe"
                               TerminateProcess="0" RebootPrompt="no" Sequence="2" />

        <Property Id="MsiLogging" Value="voicewarmupx!" />
        <!-- Injector builds can have independent GitVersion values. Install the selected package's
             owned binaries even when the prior injector reported a higher file version. -->
        <Property Id="REINSTALLMODE" Value="amus" />

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="INSTALLFOLDER" Name="SnoopMCP" />
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="AppShortcutFolder" Name="SnoopMCP" />
        </StandardDirectory>

        <ComponentGroup Id="PublishOutput" Directory="INSTALLFOLDER">
            <Files Include="$(var.PublishDir)\**" />
        </ComponentGroup>

        <Component Id="SampleShortcut" Directory="AppShortcutFolder"
                   Guid="1B9D4C6E-3A2F-4E7B-9C5D-8F1A0E2B6D34">
            <Shortcut Id="SampleStartMenuShortcut"
                      Name="SnoopMCP Sample App"
                      Description="A WPF app with authored styling/binding bugs to try SnoopMCP against."
                      Target="[INSTALLFOLDER]samples\SampleWpfApp.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\JackalopeTechnologies\SnoopMCP"
                           Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>

        <Component Id="HostShortcuts" Directory="AppShortcutFolder" Guid="*">
            <Shortcut Id="HostStartMenuShortcut" Name="SnoopMCP - WPF inspection"
                      Description="Start SnoopMCP so coding assistants can inspect WPF apps. Runs in the notification area."
                      Target="[INSTALLFOLDER]SnoopMCP.Host.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <Shortcut Id="HostLogsShortcut" Name="SnoopMCP - diagnostic logs"
                      Description="Open SnoopMCP startup, shutdown, crash, and server diagnostics."
                      Target="[INSTALLFOLDER]logs" WorkingDirectory="INSTALLFOLDER" />
            <RegistryValue Root="HKCU" Key="Software\JackalopeTechnologies\SnoopMCP"
                           Name="HostShortcuts" Type="integer" Value="1" KeyPath="yes" />
        </Component>

        <!-- Locate the previous installation so migration can preserve its non-package files. -->
        <Property Id="INSTALLDIRSAVED">
            <RegistrySearch Id="FindInstallDir" Root="HKCU"
                            Key="Software\JackalopeTechnologies\SnoopMCP" Name="InstallDir" Type="directory" />
        </Property>

        <!-- Keep runtime logs, user preferences, and user-added files. MSI removes only its own files. -->
        <Component Id="CleanupInstallFolder" Directory="INSTALLFOLDER"
                   Guid="7C1A2B3D-4E5F-4061-8A9B-0C1D2E3F4A5B">
            <RegistryValue Root="HKCU" Key="Software\JackalopeTechnologies\SnoopMCP"
                           Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>

        <!-- Legacy packages unregister clients and recursively remove runtime data during upgrade.
             Snapshot before that cleanup. Restore on success and rollback, and delete only on commit. -->
        <Binary Id="UpgradeActions" SourceFile="$(var.UpgradeActions)" />
        <CustomAction Id="PrepareUpgradeState" BinaryRef="UpgradeActions" DllEntry="PrepareUpgradeState"
                      Execute="immediate" Return="check" />
        <CustomAction Id="RecoverFailedUpgrade" BinaryRef="UpgradeActions" DllEntry="RestoreInterruptedUpgradeState"
                      Execute="immediate" Return="check" />
        <CustomAction Id="RecoverCancelledUpgrade" BinaryRef="UpgradeActions" DllEntry="RestoreInterruptedUpgradeState"
                      Execute="immediate" Return="check" />
        <CustomAction Id="RestoreUpgradeState" BinaryRef="UpgradeActions" DllEntry="RestoreUpgradeState"
                      Execute="deferred" Return="check" Impersonate="yes" />
        <CustomAction Id="CleanupUpgradeState" BinaryRef="UpgradeActions" DllEntry="CleanupUpgradeState"
                      Execute="commit" Return="ignore" Impersonate="yes" />

        <!-- Install: create the logon task. Agent registration is offered as an opt-in checkbox on the
             finish page (see RegisterAgents below), so the installer never writes into a client's config
             unless the user asks; it is also available any time from the tray or the CLI. -->
        <SetProperty Id="InstallAutostart" Before="InstallAutostart" Sequence="execute"
                     Value="&quot;[INSTALLFOLDER]SnoopMCP.Cli.exe&quot; install-autostart" />
        <CustomAction Id="InstallAutostart" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                      Execute="deferred" Return="ignore" Impersonate="yes" />

        <!-- Uninstall: remove the logon task, unregister clients. -->
        <SetProperty Id="UninstallAutostart" Before="UninstallAutostart" Sequence="execute"
                     Value="&quot;[INSTALLFOLDER]SnoopMCP.Cli.exe&quot; uninstall-autostart" />
        <CustomAction Id="UninstallAutostart" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                      Execute="deferred" Return="ignore" Impersonate="yes" />

        <SetProperty Id="UnregisterClients" Before="UnregisterClients" Sequence="execute"
                     Value="&quot;[INSTALLFOLDER]SnoopMCP.Cli.exe&quot; unregister-clients" />
        <CustomAction Id="UnregisterClients" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                      Execute="deferred" Return="ignore" Impersonate="yes" />

        <Feature Id="Main" Title="SnoopMCP" Level="1">
            <ComponentGroupRef Id="PublishOutput" />
            <ComponentRef Id="SampleShortcut" />
            <ComponentRef Id="HostShortcuts" />
            <ComponentRef Id="CleanupInstallFolder" />
        </Feature>

        <InstallExecuteSequence>
            <Custom Action="PrepareUpgradeState" Before="InstallInitialize" Condition="WIX_UPGRADE_DETECTED" />
            <!-- No script-generating action may precede RemoveExistingProducts after InstallInitialize.
                 Exit recovery also covers a failure during old-product removal, after MSI rollback. -->
            <Custom Action="RecoverFailedUpgrade" OnExit="error" Condition="RestoreUpgradeState" />
            <Custom Action="RecoverCancelledUpgrade" OnExit="cancel" Condition="RestoreUpgradeState" />
            <Custom Action="RestoreUpgradeState" After="InstallFiles" Condition="WIX_UPGRADE_DETECTED" />
            <Custom Action="CleanupUpgradeState" After="RestoreUpgradeState" Condition="WIX_UPGRADE_DETECTED" />
            <Custom Action="InstallAutostart" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
            <Custom Action="UninstallAutostart" Before="UnregisterClients" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
            <Custom Action="UnregisterClients" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
        </InstallExecuteSequence>

        <ui:WixUI Id="WixUI_Minimal" />
        <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Register SnoopMCP into detected AI agents now" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <CustomAction Id="SetLaunchTarget" Property="WixShellExecTarget"
                      Value="[INSTALLFOLDER]SnoopMCP.Host.exe" />
        <CustomAction Id="LaunchSnoopMcp" BinaryRef="Wix4UtilCA_X86" DllEntry="WixShellExec"
                      Execute="immediate" Impersonate="yes" Return="ignore" />
        <!-- Best-effort: register SnoopMCP into the AI agents detected on this machine when the user
             leaves the finish-page checkbox ticked. Return=ignore so a missing agent or a write error
             never fails the install; the detected-only switch skips agents that are not present. -->
        <CustomAction Id="SetRegisterAgentsCmd" Property="WixQuietExecCmdLine"
                      Value="&quot;[INSTALLFOLDER]SnoopMCP.Cli.exe&quot; register-clients --detected-only" />
        <CustomAction Id="RegisterAgents" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                      Execute="immediate" Impersonate="yes" Return="ignore" />
        <InstallUISequence>
            <Custom Action="SetLaunchTarget" After="CostFinalize" />
            <Custom Action="SetRegisterAgentsCmd" After="SetLaunchTarget" />
        </InstallUISequence>

        <UI>
            <ProgressText Action="InstallAutostart" Message="Creating the logon autostart task..." />
            <ProgressText Action="UninstallAutostart" Message="Removing the logon autostart task..." />
            <ProgressText Action="UnregisterClients" Message="Removing SnoopMCP from your AI tools..." />
            <!-- Register only when the user opts in; always launch the tray host on a fresh install so
                 the notification-area app comes up immediately (the logon task handles later sessions). -->
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="RegisterAgents"
                     Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSnoopMcp"
                     Condition="NOT Installed" />
        </UI>

    </Package>

</Wix>
