<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>SnoopMCP.Host</RootNamespace>
        <AssemblyName>SnoopMCP.Server</AssemblyName>
        <PlatformTarget>x64</PlatformTarget>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    </ItemGroup>

    <!--
        The old project used Microsoft.NET.Sdk.Web, which globally imported these ASP.NET namespaces.
        Under the plain SDK only these two are needed globally (ConfigureKestrel/ListenLocalhost and
        Results); everything else is imported in-file.
    -->
    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Hosting" />
        <Using Include="Microsoft.AspNetCore.Http" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SnoopMCP.Protocol\SnoopMCP.Protocol.csproj" />
    </ItemGroup>
</Project>
