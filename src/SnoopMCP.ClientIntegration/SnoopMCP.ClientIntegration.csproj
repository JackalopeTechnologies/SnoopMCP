<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SnoopMCP.ClientIntegration</RootNamespace>
        <AssemblyName>SnoopMCP.ClientIntegration</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <!-- Pinned to the stable 0.x API (Toml.Parse / ToModel / FromModel + the syntax model). Tomlyn 2.x
         is a serializer-focused rewrite that drops that model-round-trip surface this writer relies on. -->
