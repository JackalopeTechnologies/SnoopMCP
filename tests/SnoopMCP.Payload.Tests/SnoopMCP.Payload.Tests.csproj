<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>SnoopMCP.Payload.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Keep the existing VSTest workflow on .NET 10; xUnit 4 otherwise defaults to a different runner. -->
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageReference Include="Xunit.StaFact" Version="4.0.24" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SnoopMCP.Payload\SnoopMCP.Payload.csproj" />
        <ProjectReference Include="..\..\src\SnoopMCP.Protocol\SnoopMCP.Protocol.csproj" />
    </ItemGroup>
</Project>
